# ==============================================================================
# FLORETTTZ — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# 1. FRONTEND (Next.js) -> Set these in Vercel Project Settings > Environment Variables
# 2. BACKEND  (FastAPI) -> Set these in Render Web Service > Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# SECTION 1: VERCEL (FRONTEND — Next.js)
# Sirf ye 6 variables Vercel ke dashboard me add karne hain:
# ------------------------------------------------------------------------------

# 1. Backend API URL (Local: http://localhost:8000 | Vercel production: https://floretttz-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2. Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tzemepkyhzxhtiohdcrh.supabase.co

# 3. Supabase Public Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# 4. WhatsApp Business Number (Digits only: 91XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=917533832123

# 5. WhatsApp VIP Community Group Invite Link
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/HQAdFVG6arGFh77oRGZsQk?s=cl&p=a&mlu=4&ilr=4

# 6. WhatsApp Updates Channel Link
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb9L4MLG3R3Zpsx31l1U


# ------------------------------------------------------------------------------
# SECTION 2: RENDER (BACKEND — FastAPI)
# Ye variables Render Web Service ke dashboard me add karne hain (Vercel me NAHI):
# ------------------------------------------------------------------------------

# Environment mode (development / production)
FLORETTTZ_ENV=development

# Frontend URL (Render me apna Vercel frontend URL dalein, jaise: https://floretttz.vercel.app)
FLORETTTZ_FRONTEND_URL=http://localhost:3000
FLORETTTZ_ALLOWED_ORIGINS=http://localhost:3000

# Database URL (Local SQLite: sqlite:///./floretz.db | Production PostgreSQL on Supabase)
FLORETTTZ_DATABASE_URL=postgresql://user:password@host:5432/database

# Business WhatsApp Number
FLORETTTZ_WHATSAPP_BUSINESS_NUMBER=replace-with-business-whatsapp-number

# Supabase Auth Verification (Server-side JWKS)
FLORETTTZ_SUPABASE_URL=https://tzemepkyhzxhtiohdcrh.supabase.co
FLORETTTZ_SUPABASE_JWKS_URL=https://tzemepkyhzxhtiohdcrh.supabase.co/auth/v1/.well-known/jwks.json

# Server-side Integrations & Admin Credentials (Keep Private)
FLORETTTZ_NOTION_API_KEY=replace-with-your-notion-api-key
FLORETTTZ_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token
FLORETTTZ_ADMIN_NAME=replace-with-admin-name
FLORETTTZ_ADMIN_PHONE_NUMBER=replace-with-admin-phone-number
FLORETTTZ_ADMIN_EMAIL=admin@example.com
FLORETTTZ_ADMIN_PASSWORD=replace-with-a-strong-admin-password
